  "quadros": [
    {
      "depois_de": "cpp:art42",
      "titulo": "Ação penal: quem promove e como",
      "colunas": [
        "Espécie",
        "Titular",
        "Peça",
        "Ponto de prova"
      ],
      "linhas": [
        [
          "Pública incondicionada",
          "Ministério Público",
          "denúncia",
          "é a regra (art. 24); o MP não desiste da ação (art. 42)"
        ],
        [
          "Pública condicionada",
          "MP, com representação do ofendido ou requisição do Ministro da Justiça",
          "denúncia",
          "a representação é irretratável depois de oferecida a denúncia (art. 25); decadência em 6 meses (art. 38)"
        ],
        [
          "Privada",
          "ofendido ou representante (art. 30); na morte ou ausência, cônjuge, ascendente, descendente ou irmão (art. 31)",
          "queixa",
          "decadência em 6 meses (art. 38); 12 meses na violência doméstica e familiar contra a mulher (art. 38, § 2º)"
        ],
        [
          "Privada subsidiária da pública",
          "ofendido, se o MP não age no prazo legal (art. 29)",
          "queixa",
          "o MP pode aditar, repudiar e oferecer denúncia substitutiva, e retoma a ação na negligência do querelante"
        ]
      ],
      "nota": "Crime contra o patrimônio ou interesse da União, Estado e Município: a ação é sempre pública (art. 24, § 2º)."
    },
    {
      "depois_de": "cpp:art67",
      "titulo": "Sentença penal e ação civil",
      "colunas": [
        "Decisão penal",
        "Efeito no cível",
        "Base"
      ],
      "linhas": [
        [
          "Condenação transitada em julgado",
          "título para executar a reparação; o valor mínimo fixado na sentença se executa direto",
          "art. 63"
        ],
        [
          "Absolvição por estado de necessidade, legítima defesa, estrito cumprimento de dever legal ou exercício regular de direito",
          "faz coisa julgada no cível",
          "art. 65"
        ],
        [
          "Absolvição que reconhece, categoricamente, a inexistência material do fato",
          "impede a ação civil",
          "art. 66"
        ],
        [
          "Outra absolvição; arquivamento; extinção da punibilidade; fato que não constitui crime",
          "não impedem a ação civil",
          "arts. 66 e 67"
        ]
      ],
      "nota": "A ação civil pode correr junto com a penal; o juiz cível pode suspendê-la até o julgamento definitivo da penal (art. 64, parágrafo único)."
    },
